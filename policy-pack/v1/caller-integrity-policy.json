  "approved_privileged_jobs": {
    ".github/workflows/ci.yml": {
      "security": {
        "reusable_workflow": "reusable-security.yml",
        "permissions": {
          "contents": "read",
          "pull-requests": "read"
        }
      },
      "feedback": {
        "reusable_workflow": "reusable-pr-feedback.yml",
        "permissions": {
          "contents": "read",
          "pull-requests": "write"
        }
      },
      "governance": {
        "reusable_workflow": "reusable-pr-governance.yml",
        "permissions": {
          "contents": "read",
          "issues": "read",
          "pull-requests": "read"
        }
      }
    },
    ".github/workflows/cd.yml": {
      "security": {
        "reusable_workflow": "reusable-security.yml",
        "permissions": {
          "contents": "read",
          "id-token": "write"
        }
      },
      "publish": {
        "reusable_workflow": "reusable-gcp-publish.yml",
        "permissions": {
          "actions": "read",
          "contents": "write",
          "id-token": "write"
        }
      }
    }
  },
  "baseline_paths_exact": [
    ".security/.trivyignore"
  ],
  "untrusted_policy_paths_exact": [
    ".semgrep.yml",
    ".semgrep.yaml",
    ".gitleaks.toml",
    ".gitleaksignore"
  ],
  "untrusted_policy_path_prefixes": [
    ".semgrep/",
    ".security/policy/",
    ".security/rules/"
  ]
